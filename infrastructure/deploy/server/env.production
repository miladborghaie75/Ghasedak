# Ghasedak — env سرور production (الگوی گام ۳۳/۳۶)
# bootstrap.sh این فایل را به /opt/ghasedak/.env کپی و DATABASE_URL را با رمز واقعی
# جایگزین می‌کند. رمز/کلیدهای واقعی هرگز در git نمی‌نشینند (بند ۹۳).

# --- هسته ---
NODE_ENV=production
TZ=Asia/Tehran

# --- دیتابیس (روی همین سرور؛ توسط bootstrap.sh پر می‌شود) ---
DATABASE_URL=postgresql://ghasedak:CHANGE_ME@127.0.0.1:5432/ghasedak?schema=public

# --- API ---
PORT=4000
# فقط دامنه‌های واقعی — پنل ادمین روی ساب‌دامین جدا (گام ۳۶)
CORS_ORIGINS=https://www.lebaszirghasedak.ir,https://admin.lebaszirghasedak.ir
PAYMENT_CALLBACK_ORIGINS=https://www.lebaszirghasedak.ir
CSRF_ALLOWED_ORIGINS=https://www.lebaszirghasedak.ir,https://admin.lebaszirghasedak.ir
# سرویس‌به‌سرویس (فروشگاه/ادمین ← API) — یک کلید تصادفی بلند، فقط همین‌جا
GHASEDAK_API_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE

# --- رسانه و ذخیره‌سازی (مسیر مطلق؛ cwd سرویس متفاوت است) ---
MEDIA_DIR=/opt/ghasedak/apps/data/media
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/opt/ghasedak/apps/api/.storage

# --- فروشگاه / پنل (API داخلی؛ NEXT_PUBLIC_* در زمان build خوانده می‌شوند) ---
API_ORIGIN=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=https://www.lebaszirghasedak.ir
NEXT_PUBLIC_STOREFRONT_URL=https://www.lebaszirghasedak.ir
CANONICAL_HOST=www.lebaszirghasedak.ir
FRAME_ALLOWED_ORIGINS=https://admin.lebaszirghasedak.ir

# --- دامنهٔ کانونیکال و ریدایرکت (گام ۲۰) ---
# کانونیکال: www — apex با ۳۰۱ به www می‌رود (nginx + middleware)

# --- درگاه/پیامک/ایمیل/AI ---
# تا وقتی Merchant واقعی وارد نشده، سندباکس؛ لانچ فقط با ZARINPAL_SANDBOX=false
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_SENDER=
SMSIR_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_EHLO=lebaszirghasedak.ir
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- آنالیتیکس ---
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# --- بکاپ (گام ۳۷) ---
GHASEDAK_BACKUP_DIR=/var/backups/ghasedak
GHASEDAK_BACKUP_KEEP=14

# --- هشدارها (گام ۲۳/۳۸-۱ — بدون ست‌بودن: dry-run با لاگ) ---
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_BALE_BOT_TOKEN=
ALERT_BALE_CHAT_ID=
ALERT_EMAIL=

# --- هرگز در production ---
SEED_DEMO=false
GHASEDAK_MOCK_GATEWAY=
GA4_MP_ENDPOINT=
