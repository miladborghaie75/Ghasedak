[Unit]
Description=Ghasedak API (NestJS)
Documentation=file:///opt/ghasedak/docs/deploy-guide.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ghasedak
Group=ghasedak
WorkingDirectory=/opt/ghasedak/apps/api
EnvironmentFile=/opt/ghasedak/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=3
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ghasedak-api
# GHASEDAK_WORKERS عمداً set نمی‌شود → تک‌پروسه (deploy-guide بند ۲)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
