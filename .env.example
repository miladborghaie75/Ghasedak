# Ghasedak — Environment (بند ۹۳)
# این فایل فقط الگوست؛ مقادیر واقعی هرگز commit نمی‌شوند.

# --- Core ---
NODE_ENV=development
TZ=Asia/Tehran

# --- Database (packages/database) ---
# پورت‌های کانونیکال (گام F0-4 — بدون ابهام):
#   • کلستر اصلی/dev : 5433  (ساختهٔ infrastructure/pg-setup.ps1)
#   • کلستر تمرین    : 55433 (پیش‌فرض run-local.sh — GHASEDAK_DB=rehearsal)
#   • روی سرور production: همان پورتی که سرویس postgres گوش می‌دهد (معمولاً 5432)
# هر مقدار دیگری یعنی فایل/env شما با محیطی که بالا است نمی‌خواند.
DATABASE_URL="postgresql://postgres:ghasedak-dev-pw@127.0.0.1:5433/ghasedak?schema=public"

# --- API (apps/api) ---
# نکتهٔ F0-4: `PORT=0` در Node یعنی «پورت تصادفی» — در سرویس واقعی همیشه صریح
# پورت بدهید. هر مقدار نامعتبر/۰/منفی صریحاً به پیش‌فرض ۴۰۰۰ برمی‌گردد و در بوت هشدار لاگ می‌شود.
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Storage (بند ۶۰ — abstraction؛ در dev محلی) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.storage
# S3-compatible (production):
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Payment: ZarinPal (بند ۳۵ — credentials فقط اینجا) ---
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# گام F0-5 — دامنه‌های مجاز آدرس بازگشت درگاه (کاما). آدرس مطلق خارج از این
# فهرست رد می‌شود؛ آدرس نسبی روی اولین دامنه resolve می‌شود.
# اگر خالی بماند، همان CORS_ORIGINS استفاده می‌شود؛ اگر آن هم نبود پرداخت آغاز نمی‌شود.
PAYMENT_CALLBACK_ORIGINS=https://www.lebaszirghasedak.ir

# --- SMS: Kavenegar (بند ۵۲ — credentials فقط اینجا) ---
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_SENDER=

# --- Seed (بند ۹۲) ---
# فقط برای dev؛ هرگز در production فعال نشود
SEED_DEMO=false

# --- Dev-only surfaces (گام F0-7) ---
# صفحهٔ درگاه آزمایشی فروشگاه (`/checkout/pay/mock`) در build تولیدی 404 می‌دهد.
# فقط برای محیط تمرین/staging صریحاً "on" بگذارید؛ در production هرگز.
GHASEDAK_MOCK_GATEWAY=
