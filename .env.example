# Ghasedak — Environment (بند ۹۳)
# این فایل فقط الگوست؛ مقادیر واقعی هرگز commit نمی‌شوند.

# --- Core ---
NODE_ENV=development
TZ=Asia/Tehran

# --- Database (packages/database) ---
DATABASE_URL="postgresql://ghasedak:CHANGE_ME@localhost:5432/ghasedak?schema=public"

# --- API (apps/api) ---
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Storage (بند ۶۰ — abstraction؛ در dev محلی) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.storage
# S3-compatible (production):
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Payment: ZarinPal (بند ۳۵ — credentials فقط اینجا) ---
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# --- SMS: Kavenegar (بند ۵۲ — credentials فقط اینجا) ---
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_SENDER=

# --- Seed (بند ۹۲) ---
# فقط برای dev؛ هرگز در production فعال نشود
SEED_DEMO=false
