# Ghasedak — Environment (بند ۹۳)
# این فایل فقط الگوست؛ مقادیر واقعی هرگز commit نمی‌شوند.

# --- Core ---
NODE_ENV=development
TZ=Asia/Tehran

# --- Database (packages/database) ---
# پورت‌های کانونیکال (گام F0-4 — بدون ابهام):
#   • کلستر اصلی/dev : 5433  (ساختهٔ infrastructure/pg-setup.ps1)
#   • کلستر تمرین    : 55433 (پیش‌فرض run-local.sh — GHASEDAK_DB=rehearsal)
#   • روی سرور production: همان پورتی که سرویس postgres گوش می‌دهد (معمولاً 5432)
# هر مقدار دیگری یعنی فایل/env شما با محیطی که بالا است نمی‌خواند.
DATABASE_URL="postgresql://postgres:ghasedak-dev-pw@127.0.0.1:5433/ghasedak?schema=public"

# --- API (apps/api) ---
# نکتهٔ F0-4: `PORT=0` در Node یعنی «پورت تصادفی» — در سرویس واقعی همیشه صریح
# پورت بدهید. هر مقدار نامعتبر/۰/منفی صریحاً به پیش‌فرض ۴۰۰۰ برمی‌گردد و در بوت هشدار لاگ می‌شود.
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- آدرس عمومی فروشگاه برای لینک‌های پنل (NEXT_PUBLIC_* در زمان build داخل باندل می‌شود) ---
# نام کانونیکال: NEXT_PUBLIC_SITE_URL — پنل ادمین آن را برای «دیدن روی سایت» استفاده می‌کند
# (صفحه‌ساز + نظرات). پورت کانونیکال لوکال فروشگاه ۳۱۱۱ است؛ پنل ۳۲۰۰ (docs/deploy-guide.md).
# در production مقدار واقعی دامنه بگذارید (مثلاً https://www.lebaszirghasedak.ir).
NEXT_PUBLIC_SITE_URL=http://localhost:3111
# سازگاری با نام قدیمی‌تر (نظرات نیز می‌خواندش) — اگر خالی باشد همان مقدار بالا می‌ماند
NEXT_PUBLIC_STOREFRONT_URL=
# مبدأهای مجاز برای قرارگرفتن سایت داخل iframe (CSP frame-ancestors).
# فقط پنل صفحه‌ساز لازم داردش؛ بقیهٔ سایت‌ها مسدود می‌مانند. با کاما.
# در production مقدار پنل واقعی: https://admin.lebaszirghasedak.ir
FRAME_ALLOWED_ORIGINS=http://localhost:3200,https://admin.lebaszirghasedak.ir

# --- Storage (بند ۶۰ — abstraction؛ در dev محلی) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.storage
# S3-compatible (production):
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Payment: ZarinPal (بند ۳۵ — credentials فقط اینجا) ---
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# گام F0-5 — دامنه‌های مجاز آدرس بازگشت درگاه (کاما). آدرس مطلق خارج از این
# فهرست رد می‌شود؛ آدرس نسبی روی اولین دامنه resolve می‌شود.
# اگر خالی بماند، همان CORS_ORIGINS استفاده می‌شود؛ اگر آن هم نبود پرداخت آغاز نمی‌شود.
PAYMENT_CALLBACK_ORIGINS=https://www.lebaszirghasedak.ir

# --- SMS: Kavenegar (بند ۵۲ — credentials فقط اینجا) ---
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_SENDER=

# --- SMS: sms.ir / ایده‌پردازان (آداپتور idehpardaz در sms-providers.service) ---
SMSIR_API_KEY=

# --- Email تراکنشی: SMTP (گام ۱۴ — credentials فقط اینجا یا از پنل) ---
# آداپتور بدون SDK است (node:tls + AUTH LOGIN) و اتصال همیشه TLS برقرار می‌کند:
#   * پورت ۴۶۵ → implicit TLS (معمول سرورهای SMTP ایرانی/جیمیل)
#   * پورت ۵۸۷ → همان TLS (کد STARTTLS جدا ندارد؛ اگر ارائه‌دهنده فقط ۵۸۷ دارد،
#     در عمل همین اتصال TLS روی ۵۸۷ استفاده می‌شود)
# اگر این متغیرها خالی باشند، ردیف‌های ایمیل در صف Notification می‌مانند و
# هیچ «ارسال شد» جعلی ثبت نمی‌شود (بند ۱۱۱). می‌توان همین‌ها را از پنل هم
# ثبت کرد: سیستم ← پیامک و درگاه پرداخت ← کارت «کلیدهای API».
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# نامی که در EHLO اعلام می‌شود (برخی سرورها به دامنهٔ واقعی حساس‌اند)
SMTP_EHLO=ghasedak.local

# --- Analytics: GA4 (گام ۱۵ — اسکریپت فقط «پس از رضایت کاربر» لود می‌شود) ---
# شناسهٔ اندازه‌گیری (قالب G-XXXXXXXXXX) — عمومی است و در HTML صفحات دیده می‌شود،
# پس امن است. خالی = آنالیتیکس کاملاً خاموش و هیچ درخواستی ارسال نمی‌شود.
# مسیر در پنل: Admin → Data Streams → روی جریان Web کلیک کنید → «Measurement ID»
# در بالای پنل سمت راست (کنار نام جریان) است.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# فال‌بک سمت سرور (اختیاری): اگر ست نشود، API همان NEXT_PUBLIC_ بالا را می‌خواند —
# یعنی یک مقدار در همین فایل برای هر دو اپ کافی است. فقط وقتی لازم می‌شود که
# فروشگاه و API فایل‌های env جدا دارند (استقرار واقعی) و نمی‌خواهید دوبار بنویسید.
GA4_MEASUREMENT_ID=
# راز Measurement Protocol — فقط سمت سرور برای رویداد purchase (تصمیم D-3) استفاده
# می‌شود؛ هرگز پیشوند NEXT_PUBLIC نگیرد. مسیر در پنل: همان صفحهٔ جریان Web،
# بخش پایینی «Measurement Protocol API secrets» → Create → فقط یک‌بار نشان داده می‌شود.
GA4_API_SECRET=
# فقط برای تست مکانیکی dev (گام ۱۵-۵): endpoint محلی شاهد که درخواست‌های MP را
# می‌گیرد و پاسخ 2xx می‌دهد. در production هرگز ست نشود (پیش‌فرض GA4 واقعی است).
GA4_MP_ENDPOINT=
# فقط برای dev؛ هرگز در production فعال نشود
SEED_DEMO=false

# --- Dev-only surfaces (گام F0-7) ---
# صفحهٔ درگاه آزمایشی فروشگاه (`/checkout/pay/mock`) در build تولیدی 404 می‌دهد.
# فقط برای محیط تمرین/staging صریحاً "on" بگذارید؛ در production هرگز.
GHASEDAK_MOCK_GATEWAY=

# --- وضعیت پشتیبان‌گیری (بند ۴ — endpoint فقط می‌خواند، بکاپ نمی‌گیرد) ---
# مسیر پوشهٔ بکاپ روی دیسک (default ویندوزی: C:/ghasedak-backups). روی سرور Linux
# همین را به مسیر واقعی بکاپ ست کنید تا /admin/backup/status حقیقت دیسک را ببیند.
GHASEDAK_BACKUP_DIR=
# تعداد بکاپ‌های نگه‌داشته (retention) — ابزار بکاپ اعمال می‌کند، API فقط گزارش می‌دهد
GHASEDAK_BACKUP_KEEP=

# --- گام ۲۰ — دامنهٔ کانونیکال (ریدایرکت ۳۰۱ از apex به www) ---
CANONICAL_HOST=www.lebaszirghasedak.ir

# --- گام ۲۲ — مبدأهای مجاز CSRF (پنل/فروشگاه؛ اگر خالی باشد از CORS_ORIGINS خوانده می‌شود) ---
# CSRF_ALLOWED_ORIGINS=https://www.lebaszirghasedak.ir,https://admin.lebaszirghasedak.ir

# --- گام ۲۳ — هشدار مانیتورینگ (تلگرام و بله؛ بدون ست‌بودن، حالت dry-run با لاگ ساخت‌یافته) ---
# ترتیب ارسال: تلگرام ← بله ← ایمیل (SMTP) ← dry-run
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_BALE_BOT_TOKEN=
ALERT_BALE_CHAT_ID=
ALERT_EMAIL=

# --- گام ۱۸-۳ — چت‌بات هوشمند قاصدک (AI Chat — SSE + non-streaming) ---
# پایه و کلید API ارائه‌دهنده (OpenAI-compatible). اگر هر کدام ست نشوند، اپ API REQUIRES_CREDENTIAL برمی‌گرداند.
# برای Falkor، OpenAI، OpenRouter، Groq، یا هر endpoint سازگار دیگر قابل استفاده است.
# راه توصیه‌شده: از پنل ادمین (تنظیمات ← پیامک و درگاه پرداخت ← کارت «چت‌بات هوشمند») وارد و تست کنید؛
# مقادیر در apps/api/.env.local نوشته می‌شوند. مقدار مستقیم در env فقط برای استقرار بدون پنل است.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- کلید سرویس‌به‌سرویس (گام ۱۸-۳) — فروشگاه با این کلید چت‌بات را بالادست صدا می‌زند ---
# فقط سمت سرور (فروشگاه و API)؛ هرگز NEXT_PUBLIC نشود. مقدار تصادفی طولانی بسازید و در
# هر دو apps/api/.env.local و apps/storefront/.env.local یکسان بگذارید.
GHASEDAK_API_KEY=
