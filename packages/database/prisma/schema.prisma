generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                 @id @default(cuid())
  mobile              String?                @unique
  email               String?                @unique
  passwordHash        String?
  name                String?
  role                UserRole               @default(CUSTOMER)
  status              UserStatus             @default(ACTIVE)
  lastLoginAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  adminSessions       AdminSession[]
  approvalsDecided    ApprovalRequest[]      @relation("ApprovalDecidedBy")
  approvalsRequested  ApprovalRequest[]      @relation("ApprovalRequestedBy")
  auditLogs           AuditLog[]
  c2cDecisions        CardToCardSubmission[] @relation("C2cDecidedBy")
  cashierShifts       CashierShift[]
  revisions           ContentRevision[]
  expenses            Expense[]
  importBatches       ImportBatch[]
  journalEntries      JournalEntry[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  payrollContracts    PayrollContract[]
  payrollItems        PayrollItem[]
  photoTasks          PhotoTask[]
  posInvoices         PosInvoice[]
  reviews             Review[]
  settlementsPosted   SettlementBatch[]      @relation("SettlementPostedBy")
  stockLedgerEntries  StockLedgerEntry[]
  transfersByConfirm  StockTransfer[]        @relation("TransferConfirmedBy")
  transfersByRequest  StockTransfer[]        @relation("TransferRequestedBy")
  stocktakes          Stocktake[]
  stocktakesApproved  Stocktake[]            @relation("StocktakeApprovedBy")
}

model AdminSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  purpose   String    @default("admin")
  channel   String    @default("email")
  sentTo    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Permission {
  id  String @id @default(cuid())
  key String @unique
}

model RolePermission {
  id            String   @id @default(cuid())
  role          UserRole
  permissionKey String

  @@unique([role, permissionKey])
}

model Category {
  id          String              @id @default(cuid())
  parentId    String?
  name        String
  slug        String              @unique
  description String?
  imageId     String?
  iconId      String?
  bannerId    String?
  sortOrder   Int                 @default(0)
  status      EntityStatus        @default(PUBLISHED)
  seoId       String?             @unique
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  parent      Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]          @relation("CategoryTree")
  seo         SeoMeta?            @relation("CategorySeo", fields: [seoId], references: [id])
  attributes  CategoryAttribute[]
  products    Product[]
}

model CategoryAttribute {
  id           String    @id @default(cuid())
  categoryId   String
  attributeId  String
  isFilterable Boolean   @default(true)
  displayGroup String?
  sortOrder    Int       @default(0)
  attribute    Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
}

model Brand {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  logoId      String?
  description String?
  bannerId    String?
  website     String?
  status      EntityStatus @default(PUBLISHED)
  sortOrder   Int          @default(0)
  seoId       String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  seo         SeoMeta?     @relation("BrandSeo", fields: [seoId], references: [id])
  products    Product[]
}

model Attribute {
  id            String              @id @default(cuid())
  name          String
  slug          String              @unique
  type          AttributeType       @default(SELECT)
  isFilterable  Boolean             @default(true)
  isSearchable  Boolean             @default(false)
  isVariantAxis Boolean             @default(false)
  showOnCard    Boolean             @default(false)
  showOnProduct Boolean             @default(true)
  showInAdmin   Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  terms         AttributeTerm[]
  categories    CategoryAttribute[]
}

model AttributeTerm {
  id            String                 @id @default(cuid())
  attributeId   String
  value         String
  slug          String
  hex           String?
  swatchImageId String?
  sortOrder     Int                    @default(0)
  attribute     Attribute              @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  products      ProductAttributeTerm[]
  variants      VariantTerm[]

  @@unique([attributeId, slug])
}

model Product {
  id               String                 @id @default(cuid())
  name             String
  slug             String                 @unique
  shortDescription String?
  description      String?
  status           EntityStatus           @default(DRAFT)
  categoryId       String
  brandId          String?
  basePrice        BigInt
  salePrice        BigInt?
  saleStartsAt     DateTime?
  saleEndsAt       DateTime?
  costPrice        BigInt?
  videoUrl         String?
  weightGrams      Int?
  tags             String[]
  publishedAt      DateTime?
  seoId            String?                @unique
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?
  photoTasks       PhotoTask[]
  brand            Brand?                 @relation(fields: [brandId], references: [id])
  category         Category               @relation(fields: [categoryId], references: [id])
  seo              SeoMeta?               @relation("ProductSeo", fields: [seoId], references: [id])
  attributes       ProductAttributeTerm[]
  bundle           ProductBundle?
  images           ProductImage[]
  variants         ProductVariant[]
  reviews          Review[]
  wishlist         WishlistItem[]

  // گام ۲۱ — داغ‌ترین کوئری فروشگاه: کاتالوگ عمومی status=PUBLISHED + مرور بر حسب تاریخ.
  // با هدف ۵٬۰۰۰ محصول، بدون این ایندکس هر بار صفحه Seq Scan روی کل جدول است.
  @@index([status, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  mediaId   String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model PhotoTask {
  id        String          @id @default(cuid())
  productId String
  /// کادرِ استاندارد — PhotoShotKind در @ghasedak/contracts (single source of truth)
  shotKind  String
  status    PhotoTaskStatus @default(PENDING)
  /// رسانهٔ پیوست‌شدهٔ این کادر (id رسانه — رابطهٔ صریح ندارد، مثل ProductImage)
  mediaId   String?
  /// یادداشتِ عکاس (مثلاً «نور کم بود — دوباره بگیر»)
  note      String?
  actorId   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  actor     User?           @relation(fields: [actorId], references: [id])
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, shotKind])
  @@index([status])
}

model ProductAttributeTerm {
  id              String        @id @default(cuid())
  productId       String
  attributeTermId String
  term            AttributeTerm @relation(fields: [attributeTermId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeTermId])
}

model ProductVariant {
  id                   String                @id @default(cuid())
  productId            String
  sku                  String                @unique
  barcode              String?               @unique
  price                BigInt
  salePrice            BigInt?
  stockQty             Int                   @default(0)
  reservedQty          Int                   @default(0)
  lowStockThreshold    Int                   @default(0)
  status               EntityStatus          @default(PUBLISHED)
  weightGrams          Int?
  imageId              String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  cartItems            CartItem[]
  costLayers           CostLayer[]
  damageRecords        DamageRecord[]
  grItems              GoodsReceiptItem[]
  movements            InventoryMovement[]
  orderItems           OrderItem[]
  posInvoiceItems      PosInvoiceItem[]
  priceHistory         PriceHistory[]
  bundleItems          ProductBundleItem[]
  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseInvoiceItems PurchaseInvoiceItem[]
  poItems              PurchaseOrderItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  quarantineRecords    QuarantineRecord[]
  reorderPolicy        ReorderPolicy?
  stockAlerts          StockAlert[]
  ledgerEntries        StockLedgerEntry[]
  reservations         StockReservation[]
  transferItems        StockTransferItem[]
  stocktakeItems       StocktakeItem[]
  barcodes             VariantBarcode[]
  prices               VariantPrice[]
  terms                VariantTerm[]

  @@index([productId])
}

model VariantTerm {
  id              String         @id @default(cuid())
  variantId       String
  attributeTermId String
  term            AttributeTerm  @relation(fields: [attributeTermId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeTermId])
  @@index([attributeTermId])
}

model Media {
  id          String       @id @default(cuid())
  kind        String
  storageKey  String       @unique
  mime        String
  sizeBytes   BigInt
  width       Int?
  height      Int?
  alt         String?
  title       String?
  caption     String?
  focalX      Int?
  focalY      Int?
  variants    Json?
  createdAt   DateTime     @default(now())
  attachments Attachment[]
}

model Cart {
  id         String     @id @default(cuid())
  token      String     @unique
  customerId String?
  status     String     @default("active")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]
}

model CartItem {
  id                String         @id @default(cuid())
  cartId            String
  variantId         String
  qty               Int
  unitPriceSnapshot BigInt
  createdAt         DateTime       @default(now())
  cart              Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant           ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Order {
  id                     String               @id @default(cuid())
  code                   String               @unique
  channelId              String?
  warehouseId            String?
  customerId             String?
  userId                 String?
  guestName              String?
  guestMobile            String?
  addressSnapshot        Json
  status                 OrderStatus          @default(PENDING)
  paymentStatus          PaymentStatus        @default(PENDING)
  subtotal               BigInt
  shippingCost           BigInt
  discountTotal          BigInt               @default(0)
  taxableAmount          BigInt               @default(0)
  taxTotal               BigInt               @default(0)
  total                  BigInt
  currency               String               @default("IRT")
  shippingMethodSnapshot Json?
  trackingCode           String?
  notes                  String?
  customerNotes          String?
  idempotencyKey         String?              @unique
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  utmSnapshot            Json?
  coupons                CouponRedemption[]
  channel                SalesChannel?        @relation(fields: [channelId], references: [id])
  user                   User?                @relation(fields: [userId], references: [id])
  warehouse              Warehouse?           @relation(fields: [warehouseId], references: [id])
  events                 OrderEvent[]
  items                  OrderItem[]
  history                OrderStatusHistory[]
  payments               Payment[]
  attempts               PaymentAttempt[]
  refunds                Refund[]
  returnRequests         ReturnRequest[]
  shipments              Shipment[]
  reservations           StockReservation[]

  // گام ۲۱ — ایندکس‌های داغ: فهرست/فیلتر ادمین بر حسب status + createdAt
  // و مرور سفارش‌ها بر حسب تاریخ (بدون این‌ها لیست سفارش‌ها با Seq Scan رشد می‌کند).
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id                   String          @id @default(cuid())
  orderId              String
  variantId            String?
  titleSnapshot        String
  variantTermsSnapshot Json?
  qty                  Int
  unitPrice            BigInt
  salePrice            BigInt?
  lineTotal            BigInt
  order                Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant              ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  note       String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderEvent {
  id             String   @id @default(cuid())
  orderId        String
  type           String
  payload        Json?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Customer {
  id           String    @id @default(cuid())
  userId       String?   @unique
  mobile       String    @unique
  name         String?
  email        String?
  notes        String?
  status       String    @default("active")
  totalSpent   BigInt    @default(0)
  ordersCount  Int       @default(0)
  firstOrderAt DateTime?
  lastOrderAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  addresses    Address[]
  checks       Check[]
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  provinceId String
  cityId     String
  line       String
  postalCode String?
  plaque     String?
  unit       String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Province {
  id        String @id @default(cuid())
  name      String @unique
  slug      String @unique
  sortOrder Int    @default(0)
  cities    City[]
}

model City {
  id         String   @id @default(cuid())
  provinceId String
  name       String
  slug       String
  sortOrder  Int      @default(0)
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  @@unique([provinceId, slug])
}

model ShippingZone {
  id          String   @id @default(cuid())
  name        String
  provinceIds String[]
  status      String   @default("active")
}

model ShippingMethod {
  id             String  @id @default(cuid())
  zoneId         String
  name           String
  cost           BigInt
  freeOverAmount BigInt?
  etaText        String?
  sortOrder      Int     @default(0)
  status         String  @default("active")
}

model PaymentMethod {
  id                   String           @id @default(cuid())
  code                 String           @unique
  nameInternal         String
  namePublic           String
  description          String?
  iconMediaId          String?
  active               Boolean          @default(true)
  sortOrder            Int              @default(0)
  supportedChannelIds  String[]
  minAmount            BigInt?
  maxAmount            BigInt?
  customerInstructions String?
  adminInstructions    String?
  config               Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  paymentAttempts      PaymentAttempt[]
}

model PaymentProvider {
  id                   String            @id @default(cuid())
  provider             String
  name                 String
  env                  String            @default("production")
  active               Boolean           @default(true)
  priority             Int               @default(0)
  minAmount            BigInt?
  maxAmount            BigInt?
  credentialsEncrypted String?
  callbackUrl          String?
  methodIds            String[]
  /// /** درصد کارمزد درگاه (مثلاً ۱٫۲ برای ۱٫۲٪) — به‌ازای هر درگاه قابل تنظیم
  feePercentBps        Int?
  /// * مبلغ کارمزد ثابت هر تراکنش، به تومان — اگر درصده کافی نبود
  feeFlatToman         BigInt?
  /// * کارمزد از جیب خریدار گرفته شود یا از جیب فروشگاه؟ (تصمیم کاربر)
  feeBorneBy           GatewayFeeBearer  @default(MERCHANT)
  /// * روزهایی که درگاه پول را به حساب فروشگاه منتقل می‌کند (برای چرخهٔ تسویه)
  settlementDays       Int?              @default(1)
  paymentAttempts      PaymentAttempt[]
  settlementBatches    SettlementBatch[]

  @@index([feeBorneBy])
}

/// تلاش پرداخت — چند attempt برای یک سفارش مجاز (بند ۹)
model PaymentAttempt {
  id                String                  @id @default(cuid())
  orderId           String?
  posInvoiceId      String?
  methodId          String
  providerId        String?
  channelId         String?
  amount            BigInt
  state             PayState                @default(CREATED)
  idempotencyKey    String                  @unique
  providerTxId      String?                 @unique
  authority         String?
  callbackAt        DateTime?
  verifiedAt        DateTime?
  failReason        String?
  expiresAt         DateTime?
  transitions       Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  /// بستهٔ تسویه‌ای که این پرداخت در آن تسویه شد (فاز ۲٫۵)
  settlementBatchId String?
  submissions       CardToCardSubmission[]
  method            PaymentMethod           @relation(fields: [methodId], references: [id])
  order             Order?                  @relation(fields: [orderId], references: [id])
  posInvoice        PosInvoice?             @relation(fields: [posInvoiceId], references: [id])
  provider          PaymentProvider?        @relation(fields: [providerId], references: [id])
  settlementBatch   SettlementBatch?        @relation(fields: [settlementBatchId], references: [id], onUpdate: NoAction)
  reconciliations   PaymentReconciliation[]
  refunds           Refund[]

  @@index([orderId])
  @@index([state])
  @@index([settlementBatchId])
}

model CardToCardAccount {
  id                   String                 @id @default(cuid())
  bankName             String
  holderName           String
  cardNumber           String
  iban                 String?
  accountNumber        String?
  displayTitle         String?
  logoMediaId          String?
  customerInstructions String?
  visibleFields        Json?
  active               Boolean                @default(true)
  sortOrder            Int                    @default(0)
  submissions          CardToCardSubmission[]
}

model CardToCardSubmission {
  id                  String            @id @default(cuid())
  attemptId           String
  destAccountId       String
  amount              BigInt
  transferDate        String?
  transferTime        String?
  sourceBank          String?
  referenceNo         String?
  sourceCardLast4     String?
  note                String?
  receiptAttachmentId String?
  state               C2cState          @default(PENDING_VERIFICATION)
  decidedById         String?
  decidedAt           DateTime?
  decisionNote        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  attempt             PaymentAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  decidedBy           User?             @relation("C2cDecidedBy", fields: [decidedById], references: [id])
  destAccount         CardToCardAccount @relation(fields: [destAccountId], references: [id])

  @@unique([referenceNo, destAccountId, amount])
  @@index([state])
}

/// *
///  * بستهٔ تسویه — یک گزارش تسویه از درگاه (فاز ۲٫۵).
///  *
///  * برای درگاه اعتباری، پولِ چند خرید با هم و چند هفته بعد به حساب ما می‌رسد.
///  * پس یک «بسته» لازم است تا برای کل گزارش **یک** سند زده شود، نه یک سند به‌ازای
///  * هر خرید — وگرنه دفتر پر از سندهای ریز و غیرقابل‌بررسی می‌شد.
///  *
///  * چرخه: `PENDING` (وارد شده، هنوز سند نخورده) → `POSTED` (سند حسابداری زده شد)
model SettlementBatch {
  id             String           @id @default(cuid())
  providerId     String
  reference      String
  settlementDate DateTime
  grossAmount    BigInt           @default(0)
  feeAmount      BigInt           @default(0)
  netAmount      BigInt           @default(0)
  status         String           @default("PENDING")
  journalEntryId String?
  postedAt       DateTime?
  postedById     String?
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  attempts       PaymentAttempt[]
  postedBy       User?            @relation("SettlementPostedBy", fields: [postedById], references: [id], onUpdate: NoAction)
  provider       PaymentProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  journalEntry   JournalEntry?    @relation("SettlementJournal", fields: [journalEntryId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([providerId, reference], map: "SettlementBatch_provider_reference_key")
  @@index([status])
}

model PaymentReconciliation {
  id               String               @id @default(cuid())
  attemptId        String?
  providerTxId     String?
  settlementAmount BigInt?
  settlementDate   DateTime?
  status           ReconciliationStatus @default(UNMATCHED)
  note             String?
  createdAt        DateTime             @default(now())
  attempt          PaymentAttempt?      @relation(fields: [attemptId], references: [id])
}

model Payment {
  id             String               @id @default(cuid())
  orderId        String
  gatewayId      String
  amount         BigInt
  authority      String?
  refId          String?
  status         PaymentAttemptStatus @default(PENDING)
  rawPayload     Json?
  idempotencyKey String?              @unique
  createdAt      DateTime             @default(now())
  order          Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  type             String
  amount           BigInt             @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  minCartTotal     BigInt?
  maxDiscount      BigInt?
  appliesTo        Json?
  excludes         Json?
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  redemptions      CouponRedemption[]
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  orderId    String
  customerId String?
  mobile     String?
  createdAt  DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
}

model Review {
  id                 String       @id @default(cuid())
  productId          String
  userId             String?
  mobile             String?
  name               String?
  rating             Int
  body               String
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  adminReply         String?
  createdAt          DateTime     @default(now())
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User?        @relation(fields: [userId], references: [id])

  @@index([productId])
  // گام ۲۱ — صف تأیید ادمین (status=PENDING) + مرور بر حسب تاریخ
  @@index([status, createdAt])
}

model OtpCode {
  id         String    @id @default(cuid())
  mobile     String
  code       String
  purpose    String    @default("review")
  token      String?
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([mobile, createdAt])
  @@index([token])
}

model WishlistItem {
  id        String   @id @default(cuid())
  productId String
  ownerKey  String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

