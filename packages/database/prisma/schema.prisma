  isReversalOf     JournalEntry?     @relation("JournalReversal", fields: [isReversalOfId], references: [id])
  reversals        JournalEntry[]    @relation("JournalReversal")
  lines            JournalLine[]
  settlementBatches SettlementBatch[] @relation("SettlementJournal")

  @@unique([fiscalYearId, number])
  @@index([sourceType, sourceId])
  @@index([date])
}

model JournalLine {
  id           String       @id @default(cuid())
  entryId      String
  accountId    String
  debit        BigInt       @default(0)
  credit       BigInt       @default(0)
  costCenterId String?
  partyType    String?
  partyId      String?
  /// *
  ///    * انباری که این خط به آن مربوط است (فاز ۶).
  ///    *
  ///    * برای سندهای موجود `null` است و رفتار را خراب نمی‌کند — فقط یعنی آن خط
  ///    * به انبار خاصی نسبت داده نشده. با پر شدنش، گزارش «سود هر انبار» ممکن می‌شود.
  warehouseId  String?
  account      Account      @relation(fields: [accountId], references: [id])
  entry        JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id], onUpdate: NoAction)

  @@index([accountId])
  @@index([partyType, partyId])
  @@index([entryId])
  @@index([warehouseId])
  @@index([entryId, debit, credit])
}

/// *
///  * قرارداد حقوق یک کارمند — گام ۷ فاز ۲.
///  *
///  * حقوق ماهانه چیزی است که هر ماه **تکرار** می‌شود، پس داده‌اش باید نگهداری
///  * شود نه اینکه هر ماه دستی سند زده شود. یک کارمند فقط یک قرارداد فعال دارد
///  * (قید دیتابیسی) تا حقوق دو بار پرداخت نشود.
model PayrollContract {
  id                 String    @id @default(cuid())
  userId             String
  baseSalary         BigInt    @default(0)
  housingAllowance   BigInt    @default(0)
  childAllowance     BigInt    @default(0)
  transportAllowance BigInt    @default(0)
  otherAllowance     BigInt    @default(0)
  deduction          BigInt    @default(0)
  insuranceDeduction BigInt    @default(0)
  startDate          DateTime
  endDate            DateTime?
  active             Boolean   @default(true)
  note               String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// *
///  * لیست حقوق یک ماه — گام ۷ فاز ۲.
///  *
///  * چرخه: DRAFT (محاسبه و بازبینی) → POSTED (سند حسابداری زده شد).
///  * پس از POSTED دیگر قابل تغییر نیست، وگرنه حقوق پرداخت‌شده بازنویسی می‌شد.
model PayrollRun {
  id             String        @id @default(cuid())
  period         String        @unique
  title          String
  state          PayrollState  @default(DRAFT)
  totalGross     BigInt        @default(0)
  totalDeduction BigInt        @default(0)
  totalNet       BigInt        @default(0)
  journalEntryId String?
  postedAt       DateTime?
  postedById     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  items          PayrollItem[]
}

/// * ردیف حقوق یک کارمند در یک ماه
model PayrollItem {
  id        String     @id @default(cuid())
  runId     String
  userId    String
  period    String
  gross     BigInt     @default(0)
  deduction BigInt     @default(0)
  net       BigInt     @default(0)
  createdAt DateTime   @default(now())
  run       PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, period], map: "PayrollItem_one_per_user_month")
  @@index([runId])
}

model NumberSeries {
  id         String @id @default(cuid())
  scope      String @unique
  prefix     String
  nextNumber Int    @default(1)
  padding    Int    @default(5)
}

model Supplier {
  id               String            @id @default(cuid())
  name             String
  phone            String?
  email            String?
  address          String?
  taxId            String?
  bankInfo         Json?
  creditLimit      BigInt?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  checks           Check[]
  goodsReceipts    GoodsReceipt[]
  purchaseInvoices PurchaseInvoice[]
  purchaseOrders   PurchaseOrder[]
  purchaseReturns  PurchaseReturn[]
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  number     String              @unique
  supplierId String
  status     PurchaseState       @default(DRAFT)
  note       String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  receipts   GoodsReceipt[]
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  items      PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id         String         @id @default(cuid())
  orderId    String
  variantSku String
  qty        Int
  unitCost   BigInt
  po         PurchaseOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantSku], references: [sku])
}

model GoodsReceipt {
  id               String             @id @default(cuid())
  number           String             @unique
  supplierId       String
  warehouseId      String
  poId             String?
  receivedAt       DateTime           @default(now())
  note             String?
  po               PurchaseOrder?     @relation(fields: [poId], references: [id])
  supplier         Supplier           @relation(fields: [supplierId], references: [id])
  warehouse        Warehouse          @relation(fields: [warehouseId], references: [id])
  items            GoodsReceiptItem[]
  purchaseInvoices PurchaseInvoice[]
}

model GoodsReceiptItem {
  id         String         @id @default(cuid())
  receiptId  String
  variantSku String
  qty        Int
  unitCost   BigInt
  landedCost BigInt         @default(0)
  receipt    GoodsReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantSku], references: [sku])
}

model PurchaseInvoice {
  id            String                    @id @default(cuid())
  number        String                    @unique
  supplierId    String
  grId          String?
  state         PurchaseInvoiceState      @default(DRAFT)
  subtotal      BigInt
  discountTotal BigInt                    @default(0)
  shippingTotal BigInt                    @default(0)
  taxableAmount BigInt                    @default(0)
  taxTotal      BigInt                    @default(0)
  grandTotal    BigInt
  dueDate       DateTime?
  note          String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  receipt       GoodsReceipt?             @relation(fields: [grId], references: [id])
  supplier      Supplier                  @relation(fields: [supplierId], references: [id])
  items         PurchaseInvoiceItem[]
  payments      PurchasePayment[]
  deliveries    SupplierInvoiceDelivery[]
}

model PurchaseInvoiceItem {
  id         String          @id @default(cuid())
  invoiceId  String
  variantSku String
  qty        Int
  unitCost   BigInt
  invoice    PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  variant    ProductVariant  @relation(fields: [variantSku], references: [sku])
}

model PurchasePayment {
  id             String          @id @default(cuid())
  invoiceId      String
  method         String
  amount         BigInt
  cashAccountId  String?
  checkId        String?         @unique
  paidAt         DateTime        @default(now())
  idempotencyKey String?         @unique
  check          Check?          @relation(fields: [checkId], references: [id])
  invoice        PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model PurchaseReturn {
  id         String               @id @default(cuid())
  number     String               @unique
  supplierId String
  reason     String?
  createdAt  DateTime             @default(now())
  supplier   Supplier             @relation(fields: [supplierId], references: [id])
  items      PurchaseReturnItem[]
}

model PurchaseReturnItem {
  id             String         @id @default(cuid())
  returnId       String
  variantSku     String
  qty            Int
  unitCost       BigInt
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantSku], references: [sku])
}

model PosInvoice {
  id             String           @id @default(cuid())
  number         String           @unique
  channelId      String
  warehouseId    String
  shiftId        String?
  cashierId      String?
  customerId     String?
  customerName   String?
  customerMobile String?
  priceLevel     Int              @default(1)
  state          PosInvoiceState  @default(DRAFT)
  subtotal       BigInt           @default(0)
  discountTotal  BigInt           @default(0)
  extraCharges   Json?
  taxableAmount  BigInt           @default(0)
  taxTotal       BigInt           @default(0)
  grandTotal     BigInt           @default(0)
  notes          String?
  idempotencyKey String           @unique
  finalizedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  revision       Int              @default(1)
  correctsId     String?
  attempts       PaymentAttempt[]
  cashier        User?            @relation(fields: [cashierId], references: [id])
  channel        SalesChannel     @relation(fields: [channelId], references: [id])
  corrects       PosInvoice?      @relation("PosInvoiceCorrection", fields: [correctsId], references: [id])
  corrections    PosInvoice[]     @relation("PosInvoiceCorrection")
  shift          CashierShift?    @relation(fields: [shiftId], references: [id])
  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id])
  items          PosInvoiceItem[]
  payments       PosPayment[]
  returnRequests ReturnRequest[]

  @@index([shiftId])
  @@index([correctsId])
}

model PosInvoiceItem {
  id                String         @id @default(cuid())
  invoiceId         String
  variantSku        String
  qty               Int
  unitPriceSnapshot BigInt
  discount          BigInt         @default(0)
  lineTotal         BigInt
  invoice           PosInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  variant           ProductVariant @relation(fields: [variantSku], references: [sku])
}

model PosPayment {
  id             String           @id @default(cuid())
  invoiceId      String
  method         PosPaymentMethod
  amount         BigInt
  cashRegisterId String?
  checkId        String?          @unique
  ref            String?
  paidAt         DateTime         @default(now())
  cashRegister   CashRegister?    @relation(fields: [cashRegisterId], references: [id])
  check          Check?           @relation(fields: [checkId], references: [id])
  invoice        PosInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model CashRegister {
  id             String         @id @default(cuid())
  name           String
  location       String?
  openingBalance BigInt         @default(0)
  currentBalance BigInt         @default(0)
  glAccountId    String?
  active         Boolean        @default(true)
  shifts         CashierShift[]
  payments       PosPayment[]
}

model PosTicket {
  id             String   @id @default(cuid())
  userId         String
  shiftId        String?
  status         String   @default("OPEN")
  customerMobile String?
  customerName   String?
  items          Json
  discountTotal  Int      @default(0)
  version        Int      @default(1)
  audit          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, userId])
  @@index([shiftId])
}

model CashierShift {
  id           String       @id @default(cuid())
  registerId   String
  userId       String
  openingCash  BigInt       @default(0)
  expectedCash BigInt?
  actualCash   BigInt?
  difference   BigInt?
  cardTotal    BigInt       @default(0)
  onlineTotal  BigInt       @default(0)
  refundTotal  BigInt       @default(0)
  expenseTotal BigInt       @default(0)
  state        ShiftState   @default(OPEN)
  openedAt     DateTime     @default(now())
  closedAt     DateTime?
  register     CashRegister @relation(fields: [registerId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  invoices     PosInvoice[]
}

model CashAccount {
  id             String  @id @default(cuid())
  name           String
  kind           String  @default("cash")
  glAccountId    String
  openingBalance BigInt  @default(0)
  currentBalance BigInt  @default(0)
  active         Boolean @default(true)
  account        Account @relation(fields: [glAccountId], references: [id])
}

model BankAccount {
  id             String          @id @default(cuid())
  name           String
  bankName       String
  accountNumber  String
  iban           String?
  glAccountId    String
  openingBalance BigInt          @default(0)
  currentBalance BigInt          @default(0)
  active         Boolean         @default(true)
  account        Account         @relation(fields: [glAccountId], references: [id])
  statements     BankStatement[]
  checks         Check[]
}

model BankStatement {
  id               String               @id @default(cuid())
  bankAccountId    String
  date             DateTime
  amount           BigInt
  description      String?
  matchedPaymentId String?
  bankAccount      BankAccount          @relation(fields: [bankAccountId], references: [id])
  matches          BankStatementMatch[]
}

/// تخصیص/تطبیق reconciliation بانک؛ تطبیق هرگز به‌تنهایی Check را clear نمی‌کند.
model BankStatementMatch {
  id              String                  @id @default(cuid())
  statementId     String
  sourceType      String
  sourceId        String
  allocatedAmount BigInt                  @default(0)
  state           BankStatementMatchState @default(MANUAL_REVIEW)
  note            String?
  actorId         String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  checkId         String?
  check           Check?                  @relation("CheckStatementMatches", fields: [checkId], references: [id], onDelete: Restrict)
  statement       BankStatement           @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@unique([statementId, sourceType, sourceId])
  @@index([sourceType, sourceId, state])
  @@index([statementId, state])
  @@index([checkId])
}

model Check {
  id                    String               @id @default(cuid())
  direction             CheckDirection
  status                CheckStatus          @default(RECEIVED)
  number                String
  bankName              String
  branch                String?
  accountNo             String?
  amount                BigInt
  issueDate             DateTime
  dueDate               DateTime
  drawer                String?
  payee                 String?
  sourceType            String?
  sourceId              String?
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  customerId            String?
  supplierId            String?
  accountsReceivableId  String?
  treasuryBankAccountId String?
  idempotencyKey        String?              @unique
  lifecycleVersion      Int                  @default(0)
  statementMatches      BankStatementMatch[] @relation("CheckStatementMatches")
  receivable            AccountsReceivable?  @relation(fields: [accountsReceivableId], references: [id], onDelete: Restrict)
  customer              Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier              Supplier?            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  treasuryBank          BankAccount?         @relation(fields: [treasuryBankAccountId], references: [id], onDelete: Restrict)
  transitions           CheckTransition[]
  settlement            PaymentSettlement?
  posPayment            PosPayment?
  purchasePayment       PurchasePayment?

  @@index([dueDate])
  @@index([direction, status])
  @@index([customerId, dueDate])
  @@index([supplierId, dueDate])
  @@index([sourceType, sourceId])
}

model CheckTransition {
  id             String        @id @default(cuid())
  checkId        String
  version        Int
  fromStatus     CheckStatus?
  toStatus       CheckStatus
  idempotencyKey String        @unique
  actorId        String?
  reason         String?
  requestId      String?
  journalEntryId String?
  createdAt      DateTime      @default(now())
  check          Check         @relation(fields: [checkId], references: [id], onDelete: Cascade)
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@unique([checkId, version])
  @@index([checkId, createdAt])
}

model Expense {
  id            String          @id @default(cuid())
  number        String
  date          DateTime
  categoryId    String
  amount        BigInt
  cashAccountId String
  description   String?
  attachmentId  String?
  vendor        String?
  costCenterId  String?
  isRecurring   Boolean         @default(false)
  recurrence    Json?
  state         ExpenseState    @default(POSTED)
  actorId       String?
  createdAt     DateTime        @default(now())
  actor         User?           @relation(fields: [actorId], references: [id])
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
}

model ExpenseCategory {
  id          String    @id @default(cuid())
  name        String
  glAccountId String
  expenses    Expense[]
}

model CustomerAccount {
  id                 String               @id @default(cuid())
  customerId         String               @unique
  creditLimit        BigInt               @default(0)
  outstanding        BigInt               @default(0)
  dueDays            Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  receivables        AccountsReceivable[]
  creditTransactions CreditTransaction[]
}

model AccountsReceivable {
  id              String              @id @default(cuid())
  accountPId      String
  refType         String
  refId           String
  amount          BigInt
  paidAmount      BigInt              @default(0)
  dueDate         DateTime?
  state           ArState             @default(OPEN)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  exposureType    ArExposureType      @default(TRADE)
  customerAccount CustomerAccount     @relation(fields: [accountPId], references: [id])
  checks          Check[]
  settlements     PaymentSettlement[]

  @@index([refType, refId])
  @@index([accountPId, exposureType, state])
}

model PaymentSettlement {
  id      String             @id @default(cuid())
  arId    String
  method  String
  amount  BigInt
  paidAt  DateTime           @default(now())
  checkId String?            @unique
  ar      AccountsReceivable @relation(fields: [arId], references: [id], onDelete: Cascade)
  check   Check?             @relation(fields: [checkId], references: [id])
}

model CreditTransaction {
  id        String          @id @default(cuid())
  accountId String
  type      CreditTxType
  amount    BigInt
  note      String?
  actorId   String?
  createdAt DateTime        @default(now())
  account   CustomerAccount @relation(fields: [accountId], references: [id])
}

model SupplierAccount {
  id          String            @id @default(cuid())
  supplierId  String            @unique
  outstanding BigInt            @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  payables    AccountsPayable[]
}

/// تحویل فاکتور خرید به تامین‌کننده (بند ۲۷) — ردیف در دامنه؛ ارسال واقعی با آداپتور
/// (SMTP/Kavenegar) فقط با credential؛ بدون credential صف می‌ماند و جعل «ارسال شد» ممنوع (بند ۱۱۱)
model SupplierInvoiceDelivery {
  id        String          @id @default(cuid())
  invoiceId String
  channel   String
  to        String
  state     String          @default("QUEUED")
  mediaKind String?
  attempts  Int             @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([state])
}

model AccountsPayable {
  id              String          @id @default(cuid())
  accountPId      String
  refType         String
  refId           String
  amount          BigInt
  paidAmount      BigInt          @default(0)
  dueDate         DateTime?
  state           ApState         @default(OPEN)
  createdAt       DateTime        @default(now())
  supplierAccount SupplierAccount @relation(fields: [accountPId], references: [id])

  @@index([refType, refId])
}

model TaxRate {
  id            String    @id @default(cuid())
  name          String
  code          String    @unique
  rate          Int
  taxType       String    @default("vat")
  jurisdiction  String    @default("IR")
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  active        Boolean   @default(true)
  rules         TaxRule[]
}

model TaxRule {
  id        String  @id @default(cuid())
  taxRateId String
  appliesTo Json
  priority  Int     @default(0)
  taxRate   TaxRate @relation(fields: [taxRateId], references: [id])
}

model TaxTransaction {
  id            String   @id @default(cuid())
  refType       String
  refId         String
  taxableAmount BigInt
  taxAmount     BigInt
  snapshot      Json?
  createdAt     DateTime @default(now())

  @@unique([refType, refId])
}

model Shipment {
  id           String        @id @default(cuid())
  orderId      String
  methodId     String?
  provider     String?
  trackingCode String?
  status       ShipmentState @default(PENDING)
  shippedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingCode])
}

/// رویداد ورودی همه providerهای خارجی — verify + idempotent + retry (بند ۶۴)
model WebhookEvent {
  id             String    @id @default(cuid())
  provider       String
  eventType      String
  externalId     String?
  signatureValid Boolean   @default(false)
  status         String    @default("PENDING")
  retries        Int       @default(0)
  payload        Json?
  error          String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([status])
}

/// وبهوک خروجی — endpoint ثبت‌شدهٔ مشترک رویدادهای دامنه (گام ۱۸)
model WebhookEndpoint {
  id          String            @id @default(cuid())
  url         String
  secret      String
  events      String[]
  description String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deliveries  WebhookDelivery[]

  @@index([active])
}

/// تحویل وبهوک خروجی — هر رویداد×endpoint یک ردیف؛ شکست با backoff دوباره تلاش می‌شود
model WebhookDelivery {
  id            String          @id @default(cuid())
  endpointId    String
  eventName     String
  payload       Json
  state         String          @default("PENDING")
  attempts      Int             @default(0)
  responseCode  Int?
  lastError     String?
  nextAttemptAt DateTime        @default(now())
  deliveredAt   DateTime?
  createdAt     DateTime        @default(now())
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([state, nextAttemptAt])
  @@index([endpointId, createdAt])
}

/// صف ارسال به سامانه مالیاتی — بدون ادعای انطباق (بند ۴۴)
model TaxSubmission {
  id               String    @id @default(cuid())
  taxTransactionId String    @unique
  status           String    @default("QUEUED")
  attempts         Int       @default(0)
  lastError        String?
  submittedAt      DateTime?
  response         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// ضمیمه اسناد — purchase/expense/check/accounting/customer (بند ۵۸)
model Attachment {
  id        String   @id @default(cuid())
  mediaId   String
  ownerType String
  ownerId   String
  title     String?
  createdAt DateTime @default(now())
  media     Media    @relation(fields: [mediaId], references: [id])

  @@index([ownerType, ownerId])
}

/// شعبه — نرم؛ در V1 یک شعبه فعال (بند ۵۰)
model Branch {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String
  active Boolean @default(true)
}

/// بج اعتماد/مجوز — کاملاً داینامیک؛ فرانت generic رندر می‌کند (بند ۳۳–۴۶)
