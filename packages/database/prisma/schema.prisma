/// *
///  * سال مالی — دورهٔ حسابداری.
///  *
///  * قید `onlyOneOpenFiscalYear` (مهاجرت phase12) تضمین می‌کند در هر لحظه
///  * **دقیقاً یک** سال باز وجود داشته باشد.
///  *
///  * چرا این قید حیاتی است: کد ساخت سند، سال باز را با
///  * `findFirst({ where: { state: "OPEN" } })` پیدا می‌کند. اگر چند سال باز
///  * وجود داشته باشد، سندها بین آن‌ها **پخش می‌شوند** و شمارهٔ سند (که فقط
///  * در محدودهٔ سال یکتاست) دیگر قابل استناد نیست. قبلاً ۵ سال باز هم‌زمان
///  * روی دیتابیس بود.
///  *
///  * وضعیت‌ها:
///  *  • `OPEN`   — سال جاری، سند جدید پذیرفته می‌شود
///  *  • `LOCKED`  — بسته شد ولی قابل بازگشایی است (اشتباه سند قابل اصلاح)
///  *  • `CLOSED` — بستهٔ نهایی؛ تنها با بازگشایی صریح مدیر ارشد باز می‌شود
model FiscalYear {
  id              String         @id @default(cuid())
  title           String
  startsAt        DateTime
  endsAt          DateTime
  state           FiscalState    @default(OPEN)
  closedAt        DateTime?
  closedById      String?
  reopenedAt      DateTime?
  reopenedById    String?
  closingSnapshot Json?
  createdAt       DateTime?      @default(now())
  updatedAt       DateTime?      @updatedAt
  entries         JournalEntry[]

  @@index([state])
  @@index([startsAt])
}

