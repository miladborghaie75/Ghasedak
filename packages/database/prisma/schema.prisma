}

model ConsentRecord {
  id        String      @id @default(cuid())
  ownerType String      @default("customer")
  ownerKey  String
  kind      ConsentKind
  granted   Boolean
  source    String?
  createdAt DateTime    @default(now())

  @@unique([ownerKey, kind])
  @@index([ownerKey])
}

/// آمار بازدید روزانهٔ فروشگاه (گام ۱۵-۶، first-party) — همیشه‌روشن (D-5)،
/// رضایت فقط دروازهٔ GA4 است نه این جدول. «روز» = روز تهران (آفست ثابت +۳:۳۰).
/// views پس از D-6 پنجره‌ای است: هر (روز، نشست، مسیر) در بازهٔ ۳۰ دقیقه یک‌بار.
model DailyVisit {
  day       DateTime @id
  views     Int      @default(0)
  sessions  Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// بازدیدکنندهٔ یکتای هر روز — با unique([day, sessionKey]) هر session
/// روزی فقط یک‌بار در شمارش sessions می‌نشیند؛ رشدش با DailyVisit هم‌پایه است.
model DailyVisitSession {
  day        DateTime
  sessionKey String
  createdAt  DateTime @default(now())

  @@id([day, sessionKey])
  @@index([sessionKey])
}

/// پنجرهٔ یکتاییِ بازدید (گام ۱۵-۶، D-6) — هر (روز، نشست، مسیر) فقط وقتی
/// views را بالا می‌برد که آخرین پینگش دست‌کم ۳۰ دقیقه قبل بوده باشد؛
/// refresh و برگشتِ سریع به همان صفحه دوباره‌شماری نمی‌کند (از هر دو سمت:
/// sessionStorage کلاینت + این جدول سرور — سرور مرز حقیقت است).
/// updatedMany/createMany اتمیک‌اند؛ ردیف‌های قدیمی‌تر از ۲ روز پاک می‌شوند.
model DailyVisitPath {
  day        DateTime
  sessionKey String
  path       String
  updatedAt  DateTime @default(now())

  @@id([day, sessionKey, path])
  @@index([day])
}

/// مصرف روزانهٔ AI به تفکیک قابلیت — توزیع هزینهٔ ارائه‌دهنده را منصفانه بین قابلیت‌ها اندازه می‌گیرد.
/// sessionKey برای دستیارِ ادمین «admin» ثابت است؛ برای چت مشتری یک UUID تصادفی است.
/// گام ۲۴: reservedRequests = رزروهای در جریان (رزرو اتمیک پیش از تماس پولی، تسویه با مصرف واقعی).
/// هیچ متن پیام، IP خام یا شناسهٔ کاربر در این دفتر ذخیره نمی‌شود — فقط شمارش تجمیعی.
model AiUsageDay {
  day              DateTime
  capability       String
  requests         Int      @default(0)
  reservedRequests Int      @default(0)
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  updatedAt        DateTime @default(now()) @updatedAt

  @@id([day, capability])
}

/// گام ۲۴ — سقف روزانهٔ هر کاربر/نشست چت در ذخیره‌ساز مشترک (بین چند نمونهٔ API).
/// userKeyHash = SHA-256 کلید کاربر/نشست/IP — IP خام هرگز ذخیره نمی‌شود.
model AiUserDay {
  day         DateTime
  userKeyHash String
  requests    Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt

  @@id([day, userKeyHash])
  @@index([day])
}

/// گام ۲۴ — پنجره‌های rate limit در ذخیره‌ساز مشترک (بین چند نمونهٔ API).
/// windowKey = SHA-256(شناسهٔ قانون + کلید کلاینت) — IP خام هرگز ذخیره نمی‌شود.
/// windowStart ابتدای پنجرهٔ ثابت (epoch-aligned) است؛ ردیف‌های کهنه پاک می‌شوند.
model RateLimitWindow {
  windowKey   String
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt

  @@id([windowKey, windowStart])
  @@index([windowStart])
}

model DomainEventOutbox {
  id          String      @id @default(cuid())
  name        String
  payload     Json
  state       OutboxState @default(PENDING)
  attempts    Int         @default(0)
  availableAt DateTime    @default(now())
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime    @default(now())

  @@unique([name, payload])
  @@index([state, availableAt])
}

model StockAlert {
  id         String          @id @default(cuid())
  variantSku String
  channel    String          @default("sms")
  target     String
  state      StockAlertState @default(PENDING)
  notifiedAt DateTime?
  createdAt  DateTime        @default(now())
  variant    ProductVariant  @relation(fields: [variantSku], references: [sku])

  @@unique([variantSku, channel, target])
  @@index([state])
}

model InventoryMovement {
