{
  "name": "ghasedak",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev:storefront": "pnpm --filter @ghasedak/storefront dev",
    "dev:api": "pnpm --filter @ghasedak/api dev",
    "db:generate": "pnpm --filter @ghasedak/database db:generate",
    "db:migrate": "pnpm --filter @ghasedak/database db:migrate",
    "db:deploy": "pnpm --filter @ghasedak/database db:deploy"
  },
  "devDependencies": {
    "puppeteer-core": "^24.43.1",
    "turbo": "^2.3.3",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "@tailwindcss/oxide",
      "esbuild",
      "argon2"
    ],
    "overrides": {
      "multer": "^2.3.0",
      "next>postcss": "^8.5.18",
      "postcss>source-map-js": "^1.2.2",
      "@nestjs/platform-express>body-parser": "^1.20.9",
      "qs": "^6.16.1",
      "ip-address": "^10.7.5",
      "deepmerge-ts": "^8.0.2",
      "file-type": "^21.3.2"
    }
  }
}
